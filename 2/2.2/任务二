#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

namespace card {

// 打印分隔线：默认 60 个 '-'
void printLine(char c = '-', int len = 60) {
    for (int i = 0; i < len; ++i) cout << c;
    cout << endl;
}

// 打印标题：上下各一条 '=' 分隔线，标题居中
void title(const string& s) {
    const int LEN = 60;
    printLine('=', LEN);
    int pad = (LEN - static_cast<int>(s.size())) / 2;
    if (pad < 0) pad = 0;
    cout << string(pad, ' ') << s << endl;
    printLine('=', LEN);
}

} // namespace card

int main() {
    card::title("校园一卡通系统");
    card::printLine();
    card::printLine('*', 30);

    cout << left << setw(10) << "ID" << setw(10) << "Name" << "Balance" << endl;
    card::printLine('-', 30);
    return 0;
}
