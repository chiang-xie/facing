#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

const double FEE_RATE = 0.02;
const double WARNING_BALANCE = 10.0;

struct Card {
    int    id;            // 学号
    string name;          // 姓名
    double balance;       // 当前余额
    int    transactions;  // 交易次数
};

// 用 new[] 动态创建 n 个账户
Card* createCards(int n) {
    return new Card[n];
}

// 用 delete[] 释放账户数组
void destroyCards(Card* p) {
    delete[] p;   // delete[] 可安全作用于 nullptr
}

// 循环读入学号、姓名、初始余额，交易次数置 0
void inputCards(Card* arr, int n) {
    for (int i = 0; i < n; ++i) {
        cin >> arr[i].id >> arr[i].name >> arr[i].balance;
        arr[i].transactions = 0;
    }
}

// 输出账户信息表
void outputCards(const Card* arr, int n) {
    cout << left << setw(10) << "ID" << setw(10) << "Name"
         << right << setw(10) << "Balance" << setw(8) << "Trans" << endl;
    cout << fixed << setprecision(2);
    for (int i = 0; i < n; ++i) {
        cout << left  << setw(10) << arr[i].id
                      << setw(10) << arr[i].name
             << right << setw(10) << arr[i].balance
                      << setw(8)  << arr[i].transactions << endl;
    }
}

int main() {
    int n;
    cin >> n;

    Card* arr = createCards(n);   // new[]
    inputCards(arr, n);
    outputCards(arr, n);

    destroyCards(arr);            // delete[]
    arr = nullptr;

    return 0;
}

任务四
#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

const double FEE_RATE = 0.02;
const double WARNING_BALANCE = 10.0;

struct Card {
    int    id;
    string name;
    double balance;
    int    transactions;
};

// 充值：按费率 fee 扣手续费后入账（fee 默认取系统费率 0.02）
void deposit(Card& c, double amount, double fee = FEE_RATE) {
    double real = amount * (1.0 - fee);   // 实际到账金额
    c.balance += real;
    c.transactions++;
    cout << fixed << setprecision(2)
         << "Deposit " << amount << ", fee " << amount * fee
         << ", credited " << real << ", balance " << c.balance << endl;
}

// 消费：余额足够则扣款
bool spend(Card& c, double cost) {
    if (c.balance < cost) {
        cout << fixed << setprecision(2)
             << "Spend " << cost << " failed: balance " << c.balance << endl;
        return false;
    }
    c.balance -= cost;
    c.transactions++;
    cout << fixed << setprecision(2)
         << "Spend " << cost << ", balance " << c.balance << endl;
    return true;
}

// 重载：带消费项目名
bool spend(Card& c, double cost, const string& item) {
    cout << "Item: " << item << endl;
    return spend(c, cost);   // 调用上面的版本
}

// 常引用：只读，函数内不能修改 c
void showBalance(const Card& c) {
    cout << fixed << setprecision(2)
         << c.name << " balance = " << c.balance << endl;
}

// 指向常量的指针：只读，不能经 p 修改所指对象，且 p 本身可改指向
void viewStudentID(const Card* p) {
    if (p == nullptr) {
        cout << "null pointer" << endl;
        return;
    }
    cout << "Student ID: " << p->id << endl;   // p-> 等价于 (*p).
}

int main() {
    Card c = {2023001, "LiMing", 35.50, 0};

    viewStudentID(&c);
    showBalance(c);
    deposit(c, 100.0);          // 用默认费率
    deposit(c, 100.0, 0.0);     // 显式传 0，免手续费
    spend(c, 20.0, "Book");
    spend(c, 500.0);            // 余额不足
    showBalance(c);
    cout << "transactions = " << c.transactions << endl;
    return 0;
}

